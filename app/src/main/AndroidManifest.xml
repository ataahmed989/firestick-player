<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- TiviMate titles: a small server on this TV, running from when it starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirePlayer"
        android:usesCleartextTraffic="true">

        <!-- adjustPan, stated: left unstated, Android picks it again whenever a scrolling list shows or hides (Live TV's
             groups column), and each change rebuilds the window (a stall of tens to hundreds of ms on a Fire TV). -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            TiviMate and other apps open videos here, the same way they open MX Player.
            Its own task affinity means leaving always lands back in the app that opened it.
        -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:screenOrientation="landscape"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/dash+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\..*\\.mkv" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\..*\\.MKV" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\..*\\.MP4" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\..*\\.m3u8" />
                <data android:pathPattern=".*\\.M3U8" />
                <data android:pathPattern=".*\\..*\\.M3U8" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\..*\\.ts" />
                <data android:pathPattern=".*\\.TS" />
                <data android:pathPattern=".*\\..*\\.TS" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\..*\\.avi" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\..*\\.AVI" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\..*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\..*\\.MOV" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\..*\\.webm" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\..*\\.WEBM" />
                <data android:pathPattern=".*\\.mpd" />
                <data android:pathPattern=".*\\..*\\.mpd" />
                <data android:pathPattern=".*\\.MPD" />
                <data android:pathPattern=".*\\..*\\.MPD" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\.M3U8" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.TS" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\.mpd" />
                <data android:pathPattern=".*\\.MPD" />
            </intent-filter>
            <!--
                From Glass Home's Continue Watching row: a title watched before, from where it was left, or another episode
                of its show chosen in Glass Home's Episodes window (see history/).
            -->
            <intent-filter>
                <action android:name="app.fireplayer.action.RESUME" />
                <action android:name="app.fireplayer.action.PLAY_EPISODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            TiviMate's films and shows under their English names (see titles/TitleService.kt). Its own process, so the
            player never shares memory or a crash with it.
        -->
        <service
            android:name=".titles.TitleService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":titles">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local server TiviMate reaches its IPTV provider through, renaming films and shows" />
        </service>

        <receiver
            android:name=".titles.TitleService$Starter"
            android:exported="true"
            android:process=":titles">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- From Glass Home, after Fire OS has force-stopped FirePlayer (see TitleService.Starter) -->
                <action android:name="app.fireplayer.titles.START" />
            </intent-filter>
        </receiver>

        <!--
            What was watched, for Glass Home's Continue Watching row. It answers only Glass Home and FirePlayer (see
            history/ContinueProvider.kt), and never gives out where a title plays from.
        -->
        <provider
            android:name=".history.ContinueProvider"
            android:authorities="${applicationId}.continue"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!--
            ML Kit (picture subtitles read as text, subs/PictureText.kt) starts only when a picture is first read, on
            the reading thread (MlKit.initialize): its own provider, which started it on the main thread at every app
            start, is left out. MlKitComponentDiscoveryService stays: it is how ML Kit finds its parts.
        -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <!--
            ML Kit's usage reports (Google's datatransport): with no backend listed, each report is dropped as it's made
            ("Transport backend 'cct' is not registered") instead of being stored on the TV and sent later by a
            scheduled job, so nothing is ever scheduled, stored or uploaded. Text recognition doesn't depend on them.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>
