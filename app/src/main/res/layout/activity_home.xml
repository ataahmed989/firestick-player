<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1013">

    <LinearLayout
        android:id="@+id/home_column"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="64dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_700"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:lineSpacingExtra="3dp"
            android:text="Open videos from TiviMate: Settings, Playback, External player, then pick FirePlayer."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/home_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <include
        android:id="@+id/panel"
        layout="@layout/side_panel" />
</FrameLayout>
