<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:layout_margin="18dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <!-- The title is written on the window's glass, a little in from its cards' edge; the cards under it keep the same
         16 dp of glass from the window's sides and foot, and about as much under the title (its 8 dp and the list's). -->
    <TextView
        android:id="@+id/panel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:fontFamily="@font/figtree_700"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <app.fireplayer.ui.CenterScrollView
        android:id="@+id/panel_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </app.fireplayer.ui.CenterScrollView>
</LinearLayout>
