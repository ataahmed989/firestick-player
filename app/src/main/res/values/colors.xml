    <color name="text_dark">#FF111315</color>
    <color name="focus_fill">#FFF4F2EE</color>
    <color name="button_fill">#1FFFFFFF</color>
    <color name="row_fill">#E61A1E24</color>
    <!-- A row that keeps its dark look when selected (Picture & sound's top button), a little lighter than a row. -->
