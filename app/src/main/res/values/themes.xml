<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FirePlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/black</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/figtree_500</item>
        <item name="alertDialogTheme">@style/Dialog.FirePlayer</item>
    </style>

    <style name="Dialog.FirePlayer" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/figtree_500</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/sel_text_row</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:fontFamily">@font/figtree_600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:minWidth">88dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/figtree_700</item>
    </style>

    <!-- A round button's name, shown under it only while it's selected (focusEffect). Set like the icon row's names
         (item_more): plain text, 4dp below the circle, centred under it. -->
    <style name="ButtonLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <!-- Hangs out over both sides of its button (half the widest name each), so the name never widens the button's
             column and the row stays where it is when it shows. -->
        <item name="android:layout_marginStart">-48dp</item>
        <item name="android:layout_marginEnd">-48dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/figtree_600</item>
        <item name="android:includeFontPadding">true</item>
        <item name="android:maxWidth">96dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:alpha">0</item>
        <item name="android:visibility">invisible</item>
        <!-- The button already says what it does. -->
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
