<?xml version="1.0" encoding="utf-8"?>
<!-- Glass look (Settings, Glass look): see-through body with a light rim and a soft sheen on top. Selected stays as before. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/focus_fill" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#665F86D6" android:centerColor="#40304E96" android:endColor="#594C74C4" />
                    <stroke android:width="1.5dp" android:color="#80FFFFFF" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
