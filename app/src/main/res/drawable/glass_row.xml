<?xml version="1.0" encoding="utf-8"?>
<!-- Glass look: rounded see-through rows; the selected one is white with the blue ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="140">
    <item android:state_focused="true">
        <layer-list>
            <!-- A soft blue glow round the selected row, as in the mockup. -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="4dp" android:color="#593D8BFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE4ECFA" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#21FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
