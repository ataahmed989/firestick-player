<?xml version="1.0" encoding="utf-8"?>
<!-- Glass look: the switch shown for an on/off setting (off). Drawn at 34 x 20 dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="2dp" android:right="16dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE6ECF8" />
        </shape>
    </item>
</layer-list>
